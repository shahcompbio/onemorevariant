{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/shahcompbio/onemorevariant/master/assets/schema_input.json",
    "title": "shahcompbio/onemorevariant pipeline - params.input schema",
    "description": "Schema for the file provided with params.input",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "sample": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Sample name must be provided and cannot contain spaces",
                "meta": ["id"]
            },
            "variant": {
                "type": "string",
                "enum": ["snv", "indel"],
                "errorMessage": "Variant type must be 'snv' or 'indel'",
                "meta": ["variant"]
            },
            "caller": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Caller name must be provided and cannot contain spaces",
                "meta": ["caller"]
            },
            "category": {
                "type": "string",
                "enum": ["query", "truth"],
                "errorMessage": "Category must be 'query' or 'truth'",
                "meta": ["category"]
            },
            "vcf": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^\\S+\\.vcf(\\.gz)?$",
                "errorMessage": "VCF file must be provided, cannot contain spaces and must have extension '.vcf' or '.vcf.gz'"
            }
        },
        "required": ["sample", "variant", "caller", "category", "vcf"]
    }
}
