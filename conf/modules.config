/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" }, mode: params.publish_dir_mode, saveAs: { filename -> filename.equals('versions.yml') ? null : filename }]

    withName: BCFTOOLS_VIEW {
        ext.args   = { "--apply-filters PASS --output-type z --write-index=tbi -t ${params.contigs}" }
        ext.prefix = { "${meta.id}_${meta.caller}_${meta.variant}_filtered" }
        publishDir = [path: { "${params.outdir}/preprocessing/${meta.id}" }, mode: params.publish_dir_mode, enabled: false]
    }

    withName: BCFTOOLS_NORM {
        ext.args   = { "--multiallelics - --output-type z --write-index=tbi" }
        ext.prefix = { "${meta.id}_${meta.caller}_${meta.variant}_norm" }
        publishDir = [path: { "${params.outdir}/preprocessing/${meta.id}" }, mode: params.publish_dir_mode, enabled: false]
    }

    withName: BCFTOOLS_REHEADER {
        ext.args2  = { "--output-type z --write-index=tbi" }
        ext.prefix = { "${meta.id}_${meta.caller}_${meta.variant}_reheader" }
        publishDir = [path: { "${params.outdir}/preprocessing/${meta.id}" }, mode: params.publish_dir_mode, enabled: false]
    }

    withName: BCFTOOLS_CONCAT {
        ext.args   = { "--allow-overlaps --remove-duplicates --output-type z --write-index=tbi" }
        ext.prefix = { "${meta.id}_${meta.variant}_truth_concat" }
        publishDir = [path: { "${params.outdir}/truth/${meta.id}" }, mode: params.publish_dir_mode, enabled: false]
    }

    withName: BCFTOOLS_SORT {
        ext.args   = { "--output-type z --write-index=tbi" }
        ext.prefix = { "${meta.id}_${meta.variant}_truth_sorted" }
        publishDir = [path: { "${params.outdir}/truth/${meta.id}" }, mode: params.publish_dir_mode, enabled: false]
    }


    withName: BCFTOOLS_ISEC {
        ext.args   = { "--output-type z" }
        ext.prefix = { "${meta.id}" }
        publishDir = [path: { "${params.outdir}/benchmark/${meta.sample}" }, mode: params.publish_dir_mode, saveAs: { filename -> filename.equals('versions.yml') ? null : filename }]
    }

    withName: STRATIFY_VARIANTS {
        publishDir = [path: { "${params.outdir}/stratification/${meta.id}" }, mode: params.publish_dir_mode, saveAs: { filename -> filename.equals('versions.yml') ? null : filename }]
    }

    withName: AGGREGATE_SNV {
        publishDir = [path: { "${params.outdir}/summary" }, mode: params.publish_dir_mode, saveAs: { filename -> filename.equals('versions.yml') ? null : filename }]
    }

    withName: AGGREGATE_INDEL {
        publishDir = [path: { "${params.outdir}/summary" }, mode: params.publish_dir_mode, saveAs: { filename -> filename.equals('versions.yml') ? null : filename }]
    }

    withName: MULTIQC {
        ext.args   = { params.multiqc_title ? "--title \"${params.multiqc_title}\"" : '' }
        publishDir = [path: { "${params.outdir}/multiqc" }, mode: params.publish_dir_mode, saveAs: { filename -> filename.equals('versions.yml') ? null : filename }]
    }
}
